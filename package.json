{
  "name": "gantt-chart",
  "version": "0.2.0",
  "description": "Gantt Chart Desktop App (Neutralinojs)",
  "private": true,
  "scripts": {
    "clean": "rimraf dist release",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build": "npm run clean && npm run build:renderer",
    "neu:dev": "npm run build && neu run",
    "neu:build": "npm run build && node scripts/bundle-release.js",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "css-loader": "^7.1.1",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "rimraf": "^5.0.10",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
